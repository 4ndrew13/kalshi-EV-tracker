# Copy to /opt/kalshi-collector/.env  (chmod 600). Never commit.
KALSHI_DATA_DIR=/opt/kalshi-collector/data

# Google Sheets — live buckets only. Optional but strongly recommended: it is
# the offsite copy, and on a free-tier VM that is not optional.
KALSHI_SHEETS_CREDENTIALS=/opt/kalshi-collector/service-account.json
KALSHI_SHEETS_ID=
KALSHI_SHEETS_TAB=Data log

# Healthchecks.io ping URL. On a VM, silence looks exactly like success.
KALSHI_HEALTHCHECK_URL=

# Optional offsite CSV backup targets used by deploy/backup.sh
KALSHI_BACKUP_REMOTE=
KALSHI_BACKUP_GIT=
